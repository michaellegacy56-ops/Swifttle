# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings > Environment Variables.

# From your Neon dashboard (Connection string). Must end with ?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Your "Device ID" from the Account tab of the app (see README, step 5).
# Whoever has this ID can approve driver accounts. Leave empty at first.
OWNER_UID=

# Minutes your timezone is ahead of UTC. Ghana is UTC+0 all year, so 0.
TZ_OFFSET_MINUTES=0
